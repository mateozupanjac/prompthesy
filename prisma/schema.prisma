// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
//   output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// ---------- Canonical I Ching content ----------
model Trigram {
  id      Int    @id // 1..8 (QIAN,KUN,ZHEN,KAN,GEN,XUN,LI,DUI)
  key     String @unique
  name    String 
  meaning String?

  upperOf Hexagram[] @relation("hex_upper")
  lowerOf Hexagram[] @relation("hex_lower")
}

model Hexagram {
  id          Int     @id
  key         String  @unique
  slug        String  @unique
  name        String  
  judgment    String  
  imageText   String?
  comment     String? 
  footnote    String? 
  tags        String[]

  upperTrigramId Int
  lowerTrigramId Int
  upperTrigram   Trigram @relation("hex_upper", fields: [upperTrigramId], references: [id])
  lowerTrigram   Trigram @relation("hex_lower", fields: [lowerTrigramId], references: [id])

  lines Line[]

  baseForReadings   Reading[] @relation("reading_base_hex")
  resultForReadings Reading[] @relation("reading_result_hex")

  @@index([slug])
}

model Line {
  id         Int      @id @default(autoincrement())
  hexagramId Int
  number     Int // 1 (bottom) .. 6 (top)
  text       String  
  Hexagram   Hexagram @relation(fields: [hexagramId], references: [id])

  @@unique([hexagramId, number])
  @@index([hexagramId])
}

/// Keep original JSON/text you typed (for provenance/versioning)
model ContentSource {
  id         String   @id @default(cuid())
  key        String   @unique
  payload    Json
  version    String
  importedAt DateTime @default(now())
}

/// ---------- Auth.js v5 compatible ----------
model User {
  id        String   @id @default(cuid())
  name      String?
  email     String?  @unique
  image     String?
  createdAt DateTime @default(now())

  readings  Reading[]
  chats     ChatSession[]
  favorites Favorite[]
  journal   JournalEntry[]

  accounts Account[]
  sessions Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// ---------- App domain (readings, chat, share) ----------
model Reading {
  id        String   @id @default(cuid())
  userId    String?
  createdAt DateTime @default(now())

  method           String // "3_coins" | "manual"
  seed             String? // optional reproducibility
  tossesJson       Json // raw coin flips / line objects
  movingLines      Int[] // e.g., [2,5]
  baseHexagramId   Int
  resultHexagramId Int
  question         String?
  notes            String?

  User           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  baseHexagram   Hexagram      @relation("reading_base_hex", fields: [baseHexagramId], references: [id])
  resultHexagram Hexagram      @relation("reading_result_hex", fields: [resultHexagramId], references: [id])
  chats          ChatSession[]
  shares         ShareLink[]
  favorites      Favorite[]

  @@index([userId, createdAt])
  @@index([baseHexagramId])
  @@index([resultHexagramId])
}

model ChatSession {
  id        String   @id @default(cuid())
  userId    String?
  readingId String
  createdAt DateTime @default(now())

  User     User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  Reading  Reading       @relation(fields: [readingId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([readingId])
  @@index([userId, createdAt])
}

model ChatMessage {
  id        String   @id @default(cuid())
  sessionId String
  role      String // "user" | "assistant" | "system"
  content   String
  createdAt DateTime @default(now())

  Session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

model ShareLink {
  id        String    @id @default(cuid())
  readingId String
  token     String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime?

  Reading Reading @relation(fields: [readingId], references: [id], onDelete: Cascade)

  @@index([readingId])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  readingId String
  createdAt DateTime @default(now())

  User    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  Reading Reading @relation(fields: [readingId], references: [id], onDelete: Cascade)

  @@unique([userId, readingId])
  @@index([userId, createdAt])
}

model JournalEntry {
  id        String   @id @default(cuid())
  userId    String
  createdAt DateTime @default(now())
  title     String?
  body      String   @db.Text

  User User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}